##Spacecraft Class
from turtle import distance


class Spacecraft:
    def __init__(self, name, fuel_level, fuel_efficiency):
        self.name = name
        self.fuel_level = fuel_level
        self.fuel_efficiency = fuel_efficiency
        self.max_fuel_capacity = 200000  

    def add_fuel(self, amount):
        self.fuel_level = min(self.fuel_level + amount, self.max_fuel_capacity)
        self.fuel_level = max(self.fuel_level, 0)  
    
    def fuel_needed(self, distance):
        fuel_needed = distance / self.fuel_efficiency
        return fuel_needed
    
    def can_travel(self, distance):
        return self.fuel_level >= self.fuel_needed(distance)

    def launch(self, distance):
        if self.can_travel(distance):
            self.fuel_level -= self.fuel_needed(distance)
            return True
        else:
            return False

##Planet Class
class Planet:
    def __init__(self, name, coordinates, danger, resources, atmosphere):
        self.name = name
        self.coordinates = coordinates
        self.danger = danger
        self.resources = resources
        self.atmosphere = atmosphere
        self.missions_completed = 0

    def __str__(self) -> str:
        return f"Planet {self.name} at {self.coordinates} with danger level {self.danger}, resources {self.resources}, and atmosphere {self.atmosphere}"

    def __sub__(self, other) -> float:
        if not isinstance(other, Planet):
            raise TypeError("Subtraction can only be performed between two Planet objects.")
        distance = ((self.coordinates[0] - other.coordinates[0]) ** 2 + 
                    (self.coordinates[1] - other.coordinates[1]) ** 2 + 
                    (self.coordinates[2] - other.coordinates[2]) ** 2) ** 0.5
        input(f"Distance between {self.name} and {other.name}: {distance}")
        return distance
     
